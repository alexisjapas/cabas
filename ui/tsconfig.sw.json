{
  // The service worker, checked on its own.
  //
  // Its globals come from `lib.webworker`, which declares the same names as
  // `lib.dom` with different types — the two cannot share a program, so the
  // one file that needs the worker library gets its own config rather than
  // the app losing the DOM. `pnpm check` runs both.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,

    // Plain JS with JSDoc types, checked as strictly as the TypeScript is.
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/sw.js"]
}
