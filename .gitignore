/target
/.direnv
/result
/result-*

# Frontend build artifacts (ui/ — M4). The production bundle is compiled into
# the relay binary by `crates/relay/build.rs` (DECISIONS 0048), never committed.
/ui/node_modules
/ui/dist

# The cross-compiled relay, staged into the add-on's Docker context by
# `build-relay` (DECISIONS 0049). A 4 MB build product with the whole PWA in
# it; the image is what ships, not this.
/cabas-relay/cabas-relay.bin

# The wasm core and its glue, written by `build-wasm`. A build product, unlike
# `ui/src/lib/bindings/`, which is generated *and* committed so CI can diff it
# (DECISIONS 0036).
/ui/src/lib/wasm

# The local CA and the certificate `ui-serve` signs with it (DECISIONS 0041).
# The CA key is a trust anchor on every phone that installed its profile, so it
# is generated per machine and never travels.
/ui/.certs

# A development relay's sealed logs, when one is run from the repository root
# rather than from `/data` (README, "Two phones, end to end").
/.relay

# Local secrets: pairing keys, tunnel credentials, add-on options.
*.local
/secrets
